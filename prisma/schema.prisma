// Domain models (Tenant, User, PurchaseRequest, AuditLogEntry) are added in
// the first build step; see SPEC.md §3.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}
